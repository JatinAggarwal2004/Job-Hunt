# Local development defaults. Copy to .env; never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
JOB_HUNTER_DB=data/job-hunter.sqlite
TRUST_PROXY=0
# Mandatory owner email in production. Only this verified account becomes admin.
BOOTSTRAP_ADMIN_EMAIL=
REQUIRE_EMAIL_VERIFICATION=false
# Email delivery is required before public registration.
# Use brevo on free cloud hosts that block SMTP; verify your sender with the provider.
MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Job-Hunter
# SMTP is suitable only on hosts that allow outbound SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Razorpay test mode first. Never expose key secret/webhook secret to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false
# AI stays off until configured in Admin. Hosted calls additionally need this opt-in.
ENABLE_HOSTED_AI=false
AI_GEMINI_API_KEY=
# The server-approved exact model must match Admin's model name.
AI_GEMINI_MODEL=
