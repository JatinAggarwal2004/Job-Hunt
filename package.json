{
  "name": "job-hunter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build && npm run build:server",
    "preview": "vite preview --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "start": "node --env-file-if-exists=.env build/server/index.mjs",
    "test:api": "tsx --test server/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "format": "prettier --write src server shared extension tests",
    "format:check": "prettier --check src/workspace server shared extension",
    "build:server": "tsc -p tsconfig.server.json && esbuild server/index.ts --platform=node --format=esm --packages=external --bundle --sourcemap --outfile=build/server/index.mjs",
    "test": "npm run test:api && npm run test:e2e",
    "check": "npm run build && npm run format:check && npm run test:api",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "verify:deployment": "node --env-file-if-exists=.env scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "entities": "^9.0.0",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "14.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "1.63.0",
    "mammoth": "1.13.0",
    "multer": "2.5.0",
    "nodemailer": "^10.3.1",
    "pdf-parse": "2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "esbuild": "^0.28.2",
    "lighthouse": "13.6.0",
    "prettier": "^3.9.10",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
